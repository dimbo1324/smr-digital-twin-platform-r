{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smr-twin.local/schemas/report-summary.schema.json",
  "title": "SimulationReport",
  "type": "object",
  "properties": {
    "reportId": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "timeWindow": { "type": "string" },
    "simulationOnly": { "type": "boolean", "const": true },
    "disclaimer": { "type": "string" },
    "generatedBy": {
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["userId", "displayName", "role", "source"],
      "additionalProperties": false
    },
    "dataSources": {
      "type": "object",
      "properties": {
        "latestTelemetry": { "type": "string" },
        "history": { "type": "string" },
        "commands": { "type": "string" },
        "events": { "type": "string" },
        "alarms": { "type": "string" },
        "degraded": { "type": "boolean" }
      },
      "required": ["latestTelemetry", "history", "commands", "events", "alarms", "degraded"],
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "properties": {
        "mode": { "type": "string" },
        "health": { "type": "string" },
        "activeScenario": { "type": "string" },
        "running": { "type": "boolean" }
      },
      "required": ["mode", "health", "activeScenario", "running"],
      "additionalProperties": false
    },
    "historian": { "type": "object" },
    "mqtt": { "type": "object" },
    "control": { "type": "object" },
    "pid": { "type": "object" },
    "latestTelemetry": { "type": "object" },
    "telemetryStats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": { "type": "string" },
          "label": { "type": "string" },
          "unit": { "type": "string" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "avg": { "type": "number" },
          "count": { "type": "integer" },
          "source": { "type": "string" }
        },
        "required": ["tag", "label", "unit", "min", "max", "avg", "count", "source"],
        "additionalProperties": false
      }
    },
    "commands": { "$ref": "#/$defs/countSummary" },
    "events": { "$ref": "#/$defs/countSummary" },
    "alarms": {
      "type": "object",
      "properties": {
        "active": { "type": "integer" },
        "acknowledged": { "type": "integer" },
        "cleared": { "type": "integer" },
        "bySeverity": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      },
      "required": ["active", "acknowledged", "cleared"],
      "additionalProperties": false
    }
  },
  "$defs": {
    "countSummary": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "byType": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      },
      "required": ["total"],
      "additionalProperties": false
    }
  },
  "required": [
    "reportId",
    "generatedAt",
    "timeWindow",
    "simulationOnly",
    "disclaimer",
    "generatedBy",
    "dataSources",
    "system",
    "historian",
    "mqtt",
    "control",
    "pid",
    "latestTelemetry",
    "telemetryStats",
    "commands",
    "events",
    "alarms"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smr-twin.local/schemas/scenario.schema.json",
  "title": "Scenario",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
    "duration": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expectedAlarms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reportTags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safetyNote": { "type": "string" },
    "enabled": { "type": "boolean" },
    "version": { "type": "integer" },
    "simulationOnly": { "type": "boolean" }
  },
  "required": ["name", "title", "description", "simulationOnly"],
  "additionalProperties": false
}

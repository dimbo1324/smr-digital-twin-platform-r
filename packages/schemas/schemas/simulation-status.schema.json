{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smr-twin.local/schemas/simulation-status.schema.json",
  "title": "SimulationStatus",
  "type": "object",
  "properties": {
    "running": { "type": "boolean" },
    "mode": { "type": "string" },
    "health": { "type": "string" },
    "activeScenario": { "type": "string" },
    "tickMs": { "type": "integer" },
    "historySize": { "type": "integer" },
    "snapshotCount": { "type": "integer" },
    "lastSimulationTimestamp": { "type": "string" },
    "simulationOnly": { "type": "boolean" }
